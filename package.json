    "ioredis": "^5.7.0",
    "migrate": "^2.1.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.0",
    "mysql2": "^3.14.4",
    "npm": "^11.7.0",
    "npm-check-updates": "^17.1.3",
    "npx": "^10.2.2",
